<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.stubeboxpro" name="StubeBoxPro Repository" version="1.0.0" provider-name="Geliştirici">
    <extension point="xbmc.addon.repository" name="StubeBoxPro Repository">
        <dir minversion="19.0.0">
            <info compressed="false">https://ByBawox.github.io/repo/addons.xml</info>
            <checksum>https://ByBawox.github.io/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://ByBawox.github.io/repo/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="tr_TR">StubeBoxPro Resmi Deposu</summary>
        <description lang="tr_TR">StubeBoxPro eklenti ve güncelleme deposu.</description>
        <platform>all</platform>
    </extension>
</addon>
<addon id="plugin.video.stubeboxpro" name="StubeBoxPro" version="1.0.0" provider-name="Geliştirici">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="tr_TR">StubeBoxPro Kodi Eklentisi</summary>
        <description lang="tr_TR">Otomatik güncellenebilir video eklentisi.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>